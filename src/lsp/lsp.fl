module lsp;

export error LspError {
    InvalidParams,
    UnsupportedUri,
    IncrementalChange,
    InvalidPosition,
}

export structure InitializeParams {
    private {
        string workspaceValue;
        bool hasWorkspaceValue;
    }
};

export structure DocumentUpdate {
    private {
        string uriValue;
        string pathValue;
        i64 versionValue;
        string textValue;
    }
};

export structure DocumentClose {
    private {
        string uriValue;
        string pathValue;
    }
};

export structure Position {
    private {
        u32 lineValue;
        u32 characterValue;
    }
};

stringv InitializeParams::workspace(&const self) <-self {
    return self->workspaceValue.view();
}

bool InitializeParams::hasWorkspace(&const self) {
    return self->hasWorkspaceValue;
}

stringv DocumentUpdate::uri(&const self) <-self {
    return self->uriValue.view();
}

stringv DocumentUpdate::path(&const self) <-self {
    return self->pathValue.view();
}

i64 DocumentUpdate::version(&const self) {
    return self->versionValue;
}

stringv DocumentUpdate::text(&const self) <-self {
    return self->textValue.view();
}

stringv DocumentClose::uri(&const self) <-self {
    return self->uriValue.view();
}

stringv DocumentClose::path(&const self) <-self {
    return self->pathValue.view();
}

u32 Position::line(&const self) {
    return self->lineValue;
}

u32 Position::character(&const self) {
    return self->characterValue;
}
