module lsp;

@imports :: lib::json::json;

(InitializeParams, error) InitializeParams::parse([]const u8 source) {
    reader := json::Reader::init(source);
    err := reader.beginObject();
    if err != none {
        return (none, LspError.InvalidParams);
    }

    string rootUri = none;
    bool hasRootUri;
    string rootPath = none;
    bool hasRootPath;
    more, fieldErr := reader.nextObjectField();
    while fieldErr == none and more {
        if reader.keyIs("rootUri") {
            if next_value_is_null(&reader, source) {
                fieldErr = reader.readNull();
            } else {
                rootUri, fieldErr = reader.readString();
                hasRootUri = fieldErr == none;
            }
        } else if reader.keyIs("rootPath") {
            if next_value_is_null(&reader, source) {
                fieldErr = reader.readNull();
            } else {
                rootPath, fieldErr = reader.readString();
                hasRootPath = fieldErr == none;
            }
        } else {
            fieldErr = reader.skipValue();
        }
        if fieldErr == none {
            more, fieldErr = reader.nextObjectField();
        }
    }

    if fieldErr != none or reader.finish() != none {
        return (none, LspError.InvalidParams);
    }

    string workspace = none;
    bool hasWorkspace;
    if hasRootUri {
        workspace, fieldErr = file_uri_to_path(rootUri.view());
        hasWorkspace = fieldErr == none;
    } else if hasRootPath {
        workspace = rootPath;
        hasWorkspace = true;
    }
    if fieldErr != none {
        return (none, fieldErr);
    }
    return (build InitializeParams {
        self.workspaceValue = workspace;
        self.hasWorkspaceValue = hasWorkspace;
    }, none);
}

bool next_value_is_null(
    &const json::Reader reader,
    []const u8 source
) {
    usize position = reader->position();
    while position < source.len() and
        (source[position] == 32 or source[position] == 9 or
         source[position] == 10 or source[position] == 13) {
        position++;
    }
    return source.len() - position >= 4 and
        source[position] == 110 and source[position + 1] == 117 and
        source[position + 2] == 108 and source[position + 3] == 108;
}

(DocumentUpdate, error) DocumentUpdate::parseOpen([]const u8 source) {
    reader := json::Reader::init(source);
    beginErr := reader.beginObject();
    if beginErr != none {
        return (none, LspError.InvalidParams);
    }

    string uri = none;
    string text = none;
    i64 version = none;
    bool hasUri;
    bool hasText;
    bool hasVersion;

    more, err := reader.nextObjectField();
    while err == none and more {
        if reader.keyIs("textDocument") {
            err = reader.beginObject();
            childMore, childErr := reader.nextObjectField();
            while childErr == none and childMore {
                if reader.keyIs("uri") {
                    uri, childErr = reader.readString();
                    hasUri = childErr == none;
                } else if reader.keyIs("version") {
                    childErr = reader.read(&version);
                    hasVersion = childErr == none;
                } else if reader.keyIs("text") {
                    text, childErr = reader.readString();
                    hasText = childErr == none;
                } else {
                    childErr = reader.skipValue();
                }
                if childErr == none {
                    childMore, childErr = reader.nextObjectField();
                }
            }
            err = childErr;
        } else {
            err = reader.skipValue();
        }
        if err == none {
            more, err = reader.nextObjectField();
        }
    }

    if err != none or reader.finish() != none or !hasUri or !hasVersion or
        !hasText or version < 0 {
        return (none, LspError.InvalidParams);
    }
    return DocumentUpdate::create(uri, version, text);
}

(DocumentUpdate, error) DocumentUpdate::parseChange([]const u8 source) {
    reader := json::Reader::init(source);
    beginErr := reader.beginObject();
    if beginErr != none {
        return (none, LspError.InvalidParams);
    }

    string uri = none;
    string text = none;
    i64 version = none;
    bool hasUri;
    bool hasVersion;
    bool hasText;
    bool incremental;
    usize changeCount;

    more, err := reader.nextObjectField();
    while err == none and more {
        if reader.keyIs("textDocument") {
            err = reader.beginObject();
            childMore, childErr := reader.nextObjectField();
            while childErr == none and childMore {
                if reader.keyIs("uri") {
                    uri, childErr = reader.readString();
                    hasUri = childErr == none;
                } else if reader.keyIs("version") {
                    childErr = reader.read(&version);
                    hasVersion = childErr == none;
                } else {
                    childErr = reader.skipValue();
                }
                if childErr == none {
                    childMore, childErr = reader.nextObjectField();
                }
            }
            err = childErr;
        } else if reader.keyIs("contentChanges") {
            err = reader.beginArray();
            changeMore, changeErr := reader.nextArrayElement();
            while changeErr == none and changeMore {
                changeCount++;
                changeErr = reader.beginObject();
                fieldMore, itemErr := reader.nextObjectField();
                while itemErr == none and fieldMore {
                    if reader.keyIs("text") {
                        text, itemErr = reader.readString();
                        hasText = itemErr == none;
                    } else if reader.keyIs("range") {
                        incremental = true;
                        itemErr = reader.skipValue();
                    } else {
                        itemErr = reader.skipValue();
                    }
                    if itemErr == none {
                        fieldMore, itemErr = reader.nextObjectField();
                    }
                }
                changeErr = itemErr;
                if changeErr == none {
                    changeMore, changeErr = reader.nextArrayElement();
                }
            }
            err = changeErr;
        } else {
            err = reader.skipValue();
        }
        if err == none {
            more, err = reader.nextObjectField();
        }
    }

    if err != none or reader.finish() != none or !hasUri or !hasVersion or
        !hasText or version < 0 or changeCount != 1 {
        return (none, LspError.InvalidParams);
    }
    if incremental {
        return (none, LspError.IncrementalChange);
    }
    return DocumentUpdate::create(uri, version, text);
}

(DocumentClose, error) DocumentClose::parse([]const u8 source) {
    reader := json::Reader::init(source);
    beginErr := reader.beginObject();
    if beginErr != none {
        return (none, LspError.InvalidParams);
    }

    string uri = none;
    bool hasUri;
    more, err := reader.nextObjectField();
    while err == none and more {
        if reader.keyIs("textDocument") {
            err = reader.beginObject();
            childMore, childErr := reader.nextObjectField();
            while childErr == none and childMore {
                if reader.keyIs("uri") {
                    uri, childErr = reader.readString();
                    hasUri = childErr == none;
                } else {
                    childErr = reader.skipValue();
                }
                if childErr == none {
                    childMore, childErr = reader.nextObjectField();
                }
            }
            err = childErr;
        } else {
            err = reader.skipValue();
        }
        if err == none {
            more, err = reader.nextObjectField();
        }
    }

    if err != none or reader.finish() != none or !hasUri {
        return (none, LspError.InvalidParams);
    }
    path, uriErr := file_uri_to_path(uri.view());
    if uriErr != none {
        return (none, uriErr);
    }
    return (build DocumentClose {
        self.uriValue = uri;
        self.pathValue = path;
    }, none);
}

private (DocumentUpdate, error) DocumentUpdate::create(
    string uri,
    i64 version,
    string text
) {
    path, uriErr := file_uri_to_path(uri.view());
    if uriErr != none {
        return (none, uriErr);
    }
    return (build DocumentUpdate {
        self.uriValue = uri;
        self.pathValue = path;
        self.versionValue = version;
        self.textValue = text;
    }, none);
}
