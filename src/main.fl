module main;

@imports
    :: root::server::server
    :: lib::std::fmt
    :: lib::std::io::stdio;

void main() {
    standardInput := stdio::standard_input();
    standardOutput := stdio::standard_output();

    instance, constructionError := server::Server::fromStreams(
        standardInput.reader(),
        standardOutput.writer()
    );

    if constructionError != none {
        fmt::eprintln("failed to create LSP server");
        return;
    }

    runError := instance.run();
    if runError != none {
        fmt::eprintln("LSP server failed");
        return;
    }
}
